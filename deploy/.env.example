# [despliegue] Copia este archivo como .env y llénalo. El .env nunca se sube a git.
# En AWS usa secretos NUEVOS, no los de la laptop.

# --- Base de datos (las crea MySQL la primera vez) ---
MYSQL_ROOT_PASSWORD=
DB_USER=nexus
DB_PASSWORD=

# --- Sesiones y cifrado (mínimo 32 caracteres cada uno) ---
JWT_SECRET=
AES_SECRET=

# --- Correo (Gmail: contraseña de aplicación) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Dirección pública ---
# Laptop: SITE_ADDRESS=:80 y PUBLIC_URL=http://localhost
# AWS:    SITE_ADDRESS=tu-dominio.com y PUBLIC_URL=https://tu-dominio.com
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# --- Agente de recomendaciones ---
NEXUS_AGENT_ENABLED=true
# HARD: si Mistral no responde en 9 s se usan las reglas del catálogo (en CPU casi siempre).
NEXUS_AGENT_TIME_POLICY=HARD
# Avisos push por Expo (la app ya registra su token con el projectId de EAS).
NEXUS_PUSH_ENABLED=true
