    {
      "name": "4. Ver ofertas",
      "description": "Leer puntos con su payload y su vector.",
      "item": [
        {
          "name": "Primeras 10 ofertas (sin vector)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{qdrant_url}}/collections/{{alias}}/points/scroll",
              "host": [
                "{{qdrant_url}}"
              ],
              "path": [
                "collections",
                "{{alias}}",
                "points",
                "scroll"
              ]
            },
            "description": "Guarda el primer id en point_id y su actividad en activity_id para las siguientes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 10,\n  \"with_payload\": true,\n  \"with_vector\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().result;",
                  "pm.test('trae puntos', () => pm.expect(r.points.length).to.be.above(0));",
                  "pm.environment.set('point_id', r.points[0].id);",
                  "pm.environment.set('activity_id', r.points[0].payload.activity_id);",
                  "console.log('point_id guardado:', r.points[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Una oferta con su vector",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{qdrant_url}}/collections/{{alias}}/points/{{point_id}}",
              "host": [
                "{{qdrant_url}}"
              ],
              "path": [
                "collections",
                "{{alias}}",
                "points",
                "{{point_id}}"
              ]
            },
            "description": "Ejecutar despues de 'Primeras 10 ofertas'. Qdrant normaliza los vectores con coseno (norma ~1)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().result;",
                  "pm.test('vector de 1024 numeros', () => pm.expect(r.vector.length).to.eql(1024));",
                  "const norm = Math.sqrt(r.vector.reduce((s, x) => s + x * x, 0));",
                  "console.log('Norma del vector:', norm.toFixed(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "Todas las ofertas de una actividad",
