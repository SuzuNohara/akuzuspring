    {
      "name": "5. Busqueda semantica",
      "description": "Lo mismo que hace VectorCandidateSource: vectorizar y buscar.",
      "item": [
        {
          "name": "Ollama: vectorizar la consulta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ollama_url}}/api/embed",
              "host": [
                "{{ollama_url}}"
              ],
              "path": [
                "api",
                "embed"
              ]
            },
            "description": "Cambia query_text en el entorno. Usa el mismo formato que QueryText (4 lineas). Guarda el vector en query_vector.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{embed_model}}\",\n  \"input\": \"{{query_text}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const v = pm.response.json().embeddings[0];",
                  "pm.test('vector de 1024', () => pm.expect(v.length).to.eql(1024));",
                  "pm.environment.set('query_vector', JSON.stringify(v));",
                  "console.log('query_vector guardado');"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar: mejor oferta por actividad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{qdrant_url}}/collections/{{alias}}/points/query/groups",
              "host": [
                "{{qdrant_url}}"
              ],
              "path": [
                "collections",
                "{{alias}}",
                "points",
                "query",
                "groups"
              ]
            },
            "description": "Ejecutar despues de 'Ollama: vectorizar la consulta'. Una oferta por actividad, de la mas a la menos parecida.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": {{query_vector}},\n  \"group_by\": \"activity_id\",\n  \"group_size\": 1,\n  \"limit\": 10,\n  \"with_payload\": [\n    \"activity_id\",\n    \"dimension\",\n    \"location_scope\",\n    \"place_name\",\n    \"borough\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().result;",
                  "r.groups.forEach(g => console.log(g.id, g.hits[0].score.toFixed(3), JSON.stringify(g.hits[0].payload)));",
                  "pm.test('hay resultados', () => pm.expect(r.groups.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar con filtro duro (ciudad, 15 km de Coyoacan, lluvia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{qdrant_url}}/collections/{{alias}}/points/query/groups",
              "host": [
                "{{qdrant_url}}"
              ],
              "path": [
                "collections",
                "{{alias}}",
                "points",
                "query",
                "groups"
              ]
            },
            "description": "Como HardFilter: alcance, radio de 15 km y clima (bajo techo o que acepte lluvia).",
            "body": {
              "mode": "raw",
