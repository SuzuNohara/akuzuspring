<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>
    
    <groupId>com.nexus</groupId>
    <artifactId>nexus-backend</artifactId>
    <version>1.0.0</version>
    <name>Nexus Backend</name>
    <description>Backend API for Nexus social calendar application</description>
    
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JaCoCo: rellenadas por prepare-agent; vacias por defecto para que
             -Djacoco.skip=true no rompa surefire/failsafe con un token sin resolver -->
        <surefireArgLine></surefireArgLine>
        <failsafeArgLine></failsafeArgLine>

        <jacoco.version>0.8.13</jacoco.version>

        <!-- nexus-SCHEMA-01: el BOM de Boot 3.2.0 fija Testcontainers 1.19.3, que habla la API
             1.32 de Docker; el daemon local (Docker 29) exige >= 1.40 y rechaza la conexion
             ("client version 1.32 is too old"). 1.21.4 es la ultima 1.x y negocia la version. -->
        <testcontainers.version>1.21.4</testcontainers.version>

        <!-- Puerta 1 - literal, el 80 de .localsettings, por clase, sobre la lista vigilada.
             La lista vive en los <include> de la ejecucion `check`, no en una propiedad:
             jacoco exige UN <include> por patron, y varios patrones separados por comas
             dentro de un solo elemento no casan con nada, con lo que la regla quedaria
             muerta en verde. Verificado en nexus-AUTH-01. Esa lista solo crece. -->
        <jacoco.class.line.min>0.80</jacoco.class.line.min>
        <jacoco.class.branch.min>0.80</jacoco.class.branch.min>

        <!-- Puerta 2 - trinquete global. Valor medido, nunca inventado, nunca a la baja.
             0.0059 -> 0.0516 (nexus-AUTH-01, com.nexus.security)
                    -> 0.0578 al fusionar nexus-AUTH-06: los dos conjuntos de tests corren
                       juntos, asi que la cobertura es la UNION, no el maximo de las dos.
                    -> 0.0762 con nexus-SCHEMA-01: AvailabilityControllerTest recorre
                       saveUserSchedule (guarda de dia repetido) y los *IT de repositorio. -->
        <jacoco.bundle.line.min>0.0762</jacoco.bundle.line.min>

        <!-- nexus-NEXUSSYNC-01: el paquete com.nexus.nexussync (pipeline de sugerencias, Java puro sin
             Spring) trae sus propias puertas ACOTADAS AL PAQUETE: fmt, checkstyle, spotbugs+findsecbugs y
             un lint -Xlint:all -Werror (LintTest). El resto del backend no cambia de reglas.
             - nexussync.excludedGroups: los tests @Tag("arkannie") llaman a claude via arkannie; fuera de
               `test`/`verify` salvo -Dnexussync.excludedGroups=none.
             - nexussync.dir: raiz de datos/agentes (NEXUSPROJECT/nexussync). Los tests que la necesitan
               se saltan (Assumptions) si no existe. -->
        <nexussync.excludedGroups>arkannie</nexussync.excludedGroups>
        <nexussync.dir>${project.basedir}/../nexussync</nexussync.dir>
        <fmt-maven-plugin.version>2.24</fmt-maven-plugin.version>
        <maven-checkstyle-plugin.version>3.4.0</maven-checkstyle-plugin.version>
        <spotbugs-maven-plugin.version>4.8.6.6</spotbugs-maven-plugin.version>
        <findsecbugs-plugin.version>1.13.0</findsecbugs-plugin.version>
        <dependency-check-maven.version>10.0.3</dependency-check-maven.version>
    </properties>
    
    <dependencies>
        <!-- Spring Boot Starter Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <!-- Spring Boot Starter Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Boot Starter Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        
        <!-- Spring Boot Starter Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.3</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        
        <!-- Spring Boot Starter Mail -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        
        <!-- Spring Boot DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        
        <!-- nexus-NEXUSSYNC-01: CSV de kb/ (RFC 4180) y YAML de params/. commons-csv no lo gestiona el BOM
             de Boot (version explicita); jackson-dataformat-yaml si (sin version). databind y jsr310 ya
             vienen con spring-boot-starter-web. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Spring Boot Starter Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Spring Security Test -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- nexus-SCHEMA-01: MySQL real en los *IT (contrato del arnes: Testcontainers, no H2). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <!--
      ARNES DE TEST - contrato para toda actividad que anada tests (nexus-TEST-02).

      1. Test unitario  -> src/test/java/.../XxxTest.java. Corre en `mvn test` (surefire).
                           Sin contexto Spring.
      2. Test integracion -> src/test/java/.../XxxIT.java. Corre SOLO en `mvn verify`
                           (failsafe). Un contexto Spring exige base de datos: usa
                           Testcontainers (aprobado 2026-09-07), no H2.
      3. Al cubrir una clase, ANADIRLA a los <include> de la regla CLASS de la ejecucion
         `check`. Desde ese momento queda sujeta al 80 % de linea y de rama y no puede
         bajar. Esa lista solo crece.
         OJO: el patron usa PUNTOS (com.nexus.util.*). Con barras no casa y la regla
         no se evalua: no da error, simplemente queda muerta en verde. Verificado en T-13.
         OJO 2: un <include> por patron. Varios patrones separados por comas dentro de un
         mismo <include> tampoco casan, y la regla muere igual de verde. Por eso la lista
         dejo de ser una propiedad en nexus-AUTH-01.
      4. Al terminar, SUBIR <jacoco.bundle.line.min> al valor medido. Ese numero nunca baja.
         Se mide con:
           awk -F, 'NR>1{m+=$8;c+=$9} END{printf "%.4f\n", int(c/(m+c)*10000)/10000}' \
               target/site/jacoco-merged/jacoco.csv

      Comando canonico: `mvn clean verify` desde akuzuspring/.
      `mvn test` corre unitarios e informe unitario, pero NO la puerta.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- T-04: surefire. Sin <version>: la aporta spring-boot-starter-parent (3.1.2).
                 @{...} es sustitucion tardia, resuelta al arrancar el fork, despues de
                 que prepare-agent haya poblado la propiedad. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{surefireArgLine}</argLine>
                    <includes><include>**/*Test.java</include></includes>
                    <excludes><exclude>**/*IT.java</exclude></excludes>
                    <!-- nexus-NEXUSSYNC-01 -->
                    <excludedGroups>${nexussync.excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <nexussync.dir>${nexussync.dir}</nexussync.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- T-08: failsafe. Sin <version> y sin <executions>: las metas
                 integration-test/verify y el classesDirectory los aporta el padre. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{failsafeArgLine}</argLine>
                    <includes><include>**/*IT.java</include></includes>
                    <systemPropertyVariables>
                        <nexus.harness.phase>integration-test</nexus.harness.phase>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- T-05/T-06: JaCoCo. excludes se aplica a informes Y a check: fuera del
                 denominador el arranque, los DTO y las entidades. Lombok sale por @Generated
                 gracias a lombok.config. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/nexus/NexusApplication.class</exclude>
                        <exclude>com/nexus/dto/**</exclude>
                        <exclude>com/nexus/entity/**</exclude>
                        <exclude>com/nexus/model/**</exclude>
                        <!-- UserRole.java declara `package main.java.com.nexus.entity`, asi que
                             compila fuera del arbol com/nexus/. Ver nexus-JAVA-01. -->
                        <exclude>main/java/**</exclude>
                        <!-- nexus-NEXUSSYNC-01: las UNICAS dos exclusiones del paquete: el main de la CLI
                             y el lanzador real de procesos (arkannie). Todo lo demas entra en la regla CLASS. -->
                        <exclude>com/nexus/nexussync/cli/Main.class</exclude>
                        <exclude>com/nexus/nexussync/ann/DefaultLauncher.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution><id>agent-unit</id>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                            <propertyName>surefireArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution><id>report-unit</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                    <execution><id>agent-it</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>prepare-agent-integration</goal></goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                            <propertyName>failsafeArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution><id>merge-exec</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>merge</goal></goals>
                        <configuration>
                            <fileSets><fileSet>
                                <directory>${project.build.directory}</directory>
                                <includes><include>jacoco.exec</include><include>jacoco-it.exec</include></includes>
                            </fileSet></fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <execution><id>report-merged</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- Declarada DESPUES de report-merged a proposito: las dos caen en `verify`
                         y ese es el orden de ejecucion, asi que cuando la puerta rompe el build
                         el HTML que explica por que ya existe. -->
                    <execution><id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.nexus.util.*</include>
                                        <!-- nexus-AUTH-01: emisor de JWT y su configuracion. -->
                                        <include>com.nexus.security.*</include>
                                        <!-- nexus-AUTH-06: solo CorsProperties (100 % linea y rama).
                                             SecurityConfig NO entra: 10/28 lineas. -->
                                        <include>com.nexus.config.CorsProperties</include>
                                        <!-- nexus-NEXUSSYNC-01: todo el paquete, linea y rama. -->
                                        <include>com.nexus.nexussync.*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value>
                                               <minimum>${jacoco.class.line.min}</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value>
                                               <minimum>${jacoco.class.branch.min}</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Trinquete global. Valor MEDIDO en T-14, nunca inventado.
                                     Sube al ampliar cobertura; no baja nunca. -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value>
                                               <minimum>${jacoco.bundle.line.min}</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- nexus-NEXUSSYNC-01: google-java-format, solo ficheros bajo .../nexussync/... -->
            <plugin>
                <groupId>com.spotify.fmt</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <version>${fmt-maven-plugin.version}</version>
                <configuration>
                    <style>google</style>
                    <filesPathPattern>.*[/\\]nexussync[/\\].*</filesPathPattern>
                    <skipSortingImports>false</skipSortingImports>
                </configuration>
                <executions>
                    <execution><id>nexussync-fmt</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- nexus-NEXUSSYNC-01: google_checks, solo com/nexus/nexussync/** (main y test).
                 google_checks emite severidad warning: violationSeverity=warning para que rompa. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>google_checks.xml</configLocation>
                    <includes>com/nexus/nexussync/**/*.java</includes>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <suppressionsLocation>checkstyle-suppressions.xml</suppressionsLocation>
                    <violationSeverity>warning</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                    <consoleOutput>true</consoleOutput>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution><id>nexussync-checkstyle</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- nexus-NEXUSSYNC-01: SpotBugs + FindSecBugs, solo clases de com.nexus.nexussync. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <onlyAnalyze>com.nexus.nexussync.-</onlyAnalyze>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                    <failOnError>true</failOnError>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution><id>nexussync-spotbugs</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- nexus-NEXUSSYNC-01: OWASP dependency-check SOLO bajo -Paudit (descarga la base NVD: lento).
             -Ddependency-check.skip=true permite comprobar que el perfil existe sin descargar nada. -->
        <profile>
            <id>audit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check-maven.version}</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
